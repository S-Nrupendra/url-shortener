        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "if (response.token) {\r",
                  "    pm.collectionVariables.set(\"token\", response.token);\r",
                  "    console.log(\"Token saved automatically\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
